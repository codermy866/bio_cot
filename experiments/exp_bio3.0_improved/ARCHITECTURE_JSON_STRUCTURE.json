  "loss_functions": {
    "total_loss": "L_total = λ_cls·L_cls + λ_ot·L_ot + λ_sparse·L_sparse + λ_consist·L_consist + λ_adv·L_adv",
    "components": [
      {
        "name": "Classification Loss",
        "symbol": "L_cls",
        "weight": "λ_cls = 2.0",
        "description": "Cross-entropy loss for classification"
      },
      {
        "name": "OT Loss",
        "symbol": "L_ot",
        "weight": "λ_ot = 0.5",
        "description": "Sinkhorn optimal transport loss"
      },
      {
        "name": "Sparse Loss",
        "symbol": "L_sparse",
        "weight": "λ_sparse = 0.01",
        "description": "L1 + Entropy loss for attention sparsity"
      },
      {
        "name": "Consistency Loss",
        "symbol": "L_consist",
        "weight": "λ_consist = 0.2",
        "description": "Counterfactual consistency loss"
      },
      {
        "name": "Adversarial Loss",
        "symbol": "L_adv",
        "weight": "λ_adv = 0.5",
        "description": "Adversarial loss for domain discrimination"
      }
    ]
  },
  "key_innovations": [
    {
      "name": "Knowledge Notes",
      "description": "RAG-based semantic enhancement from medical knowledge base",
